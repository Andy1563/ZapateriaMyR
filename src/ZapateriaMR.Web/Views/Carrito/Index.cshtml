@model ZapateriaMR.Web.ViewModels.Carrito.CarritoIndexViewModel

@{
    ViewData["Title"] = "Carrito";
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Carrito de compras</h1>
        <p class="text-muted mb-0">Revisa los productos seleccionados antes de confirmar tu pedido.</p>
    </div>

    <a asp-controller="Tienda" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        Seguir comprando
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <h5 class="fw-semibold">Tu carrito está vacío</h5>
            <p class="text-muted">Agrega productos desde la tienda para comenzar tu compra.</p>

            <a asp-controller="Tienda" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                Ir a la tienda
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th>Precio</th>
                                    <th style="width: 160px;">Cantidad</th>
                                    <th>Subtotal</th>
                                    <th class="text-end pe-4">Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                                {
                                                    <img src="@item.ImagenUrl"
                                                         alt="@item.Nombre"
                                                         class="product-thumb" />
                                                }
                                                else
                                                {
                                                    <div class="product-thumb-placeholder">
                                                        @item.Nombre.Substring(0, 1).ToUpper()
                                                    </div>
                                                }

                                                <div>
                                                    <div class="fw-semibold">@item.Nombre</div>
                                                    <div class="text-muted small">
                                                        @item.CodigoSku
                                                        @if (!string.IsNullOrWhiteSpace(item.Marca))
                                                        {
                                                            <span> · @item.Marca</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.Color))
                                                        {
                                                            <span> · @item.Color</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.Talla))
                                                        {
                                                            <span> · Talla @item.Talla</span>
                                                        }
                                                    </div>

                                                    <div class="text-muted small">
                                                        Disponible: @item.CantidadDisponible
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="fw-semibold">
                                            ₡@item.PrecioUnitario.ToString("N2")
                                        </td>

                                        <td>
                                            <form asp-action="Actualizar" method="post" class="d-flex gap-2">
                                                <input type="hidden" name="productoId" value="@item.ProductoId" />

                                                <input type="number"
                                                       name="cantidad"
                                                       value="@item.Cantidad"
                                                       min="1"
                                                       max="@item.CantidadDisponible"
                                                       class="form-control rounded-pill" />

                                                <button type="submit" class="btn-product-action action-edit">
                                                    OK
                                                </button>
                                            </form>
                                        </td>

                                        <td class="fw-bold">
                                            ₡@item.Subtotal.ToString("N2")
                                        </td>

                                        <td class="text-end pe-4">
                                            <form asp-action="Eliminar"
                                                  method="post"
                                                  onsubmit="return confirm('¿Eliminar este producto del carrito?');">
                                                <input type="hidden" name="productoId" value="@item.ProductoId" />

                                                <button type="submit" class="btn-product-action action-delete">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <form asp-action="Vaciar"
                  method="post"
                  class="mt-3"
                  onsubmit="return confirm('¿Seguro que deseas vaciar el carrito?');">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                    Vaciar carrito
                </button>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Resumen</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Productos</span>
                        <span class="fw-semibold">@Model.CantidadTotal unidades</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">Total</span>
                        <span class="fw-bold fs-4">₡@Model.Total.ToString("N2")</span>
                    </div>

                    <a asp-controller="Checkout"
                       asp-action="Index"
                       class="btn btn-primary rounded-pill w-100">
                        Confirmar pedido
                    </a>

                    <p class="text-muted small mt-3 mb-0">
                        Necesitas iniciar sesión como cliente para confirmar el pedido.
                    </p>
                </div>
            </div>
        </div>
    </div>
}