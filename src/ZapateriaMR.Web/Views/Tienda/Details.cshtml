@model ZapateriaMR.Application.DTOs.Tienda.TiendaProductoDetalleDto

@{
    ViewData["Title"] = "Detalle de producto";
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Detalle de producto</h1>
        <p class="text-muted mb-0">Consulta la información completa antes de agregarlo al carrito.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        Volver a tienda
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                {
                    <img src="@Model.ImagenUrl"
                         alt="@Model.Nombre"
                         class="img-fluid rounded-4 product-detail-image" />
                }
                else
                {
                    <div class="product-image-empty">
                        Sin imagen
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <span class="badge text-bg-light border mb-3">@Model.Categoria</span>

                <h2 class="fw-bold mb-2">@Model.Nombre</h2>

                <p class="text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Descripcion)
                        ? "Producto disponible en tienda."
                        : Model.Descripcion)
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <span class="text-muted small">SKU</span>
                        <div class="fw-semibold">@Model.CodigoSku</div>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small">Marca</span>
                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Marca) ? Model.Marca : "No registrada")</div>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small">Color</span>
                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Color) ? Model.Color : "No registrado")</div>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small">Talla</span>
                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Talla) ? Model.Talla : "No registrada")</div>
                    </div>
                </div>

                <div class="border rounded-4 p-4 bg-light mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small d-block">Precio</span>
                            <h2 class="fw-bold mb-0">₡@Model.PrecioVenta.ToString("N2")</h2>
                        </div>

                        <span class="badge rounded-pill text-bg-success">
                            @Model.CantidadDisponible disponible
                        </span>
                    </div>
                </div>

                <form asp-controller="Carrito" asp-action="Agregar" method="post" class="mt-4">
                    <input type="hidden" name="productoId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cantidad</label>
                            <input type="number"
                                   name="cantidad"
                                   value="1"
                                   min="1"
                                   max="@Model.CantidadDisponible"
                                   class="form-control form-control-lg rounded-pill" />
                        </div>

                        <div class="col-md-8 d-grid">
                            <label class="form-label fw-semibold d-none d-md-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                                Agregar al carrito
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>