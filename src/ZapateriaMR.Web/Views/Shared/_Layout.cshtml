@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string Active(string controller)
    {
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Zapatería M y R</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZapateriaMR.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a asp-controller="Home" asp-action="Index" class="app-brand">
                <div class="app-brand-icon">
                    Z
                </div>

                <div>
                    <div class="app-brand-title">Zapatería M y R</div>
                    <div class="app-brand-subtitle">Panel administrativo</div>
                </div>
            </a>

            <nav class="app-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Administrador") || User.IsInRole("UsuarioDueño"))
                    {
                        <div class="app-nav-section">Administración</div>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="app-nav-link @Active("Home")">
                            <span class="app-nav-icon">🏠</span>
                            <span>Dashboard</span>
                        </a>

                        <a asp-controller="Productos"
                           asp-action="Index"
                           class="app-nav-link @Active("Productos")">
                            <span class="app-nav-icon">👟</span>
                            <span>Productos</span>
                        </a>

                        <a asp-controller="Inventario"
                           asp-action="Index"
                           class="app-nav-link @Active("Inventario")">
                            <span class="app-nav-icon">📦</span>
                            <span>Inventario</span>
                        </a>

                        <a asp-controller="Pedidos"
                           asp-action="Index"
                           class="app-nav-link @Active("Pedidos")">
                            <span class="app-nav-icon">🧾</span>
                            <span>Pedidos</span>
                        </a>
                    }

                    if (User.IsInRole("Administrador"))
                    {
                        <div class="app-nav-section">Seguridad</div>

                        <a asp-controller="Auditoria"
                           asp-action="Index"
                           class="app-nav-link @Active("Auditoria")">
                            <span class="app-nav-icon">🛡️</span>
                            <span>Auditoría</span>
                        </a>

                        <a asp-controller="Usuarios"
                           asp-action="Index"
                           class="app-nav-link @Active("Usuarios")">
                            <span class="app-nav-icon">👥</span>
                            <span>Usuarios</span>
                        </a>
                    }

                    <div class="app-nav-section">Cliente</div>

                    <a asp-controller="Tienda"
                       asp-action="Index"
                       class="app-nav-link @Active("Tienda")">
                        <span class="app-nav-icon">🛒</span>
                        <span>Tienda cliente</span>
                    </a>

                    <a asp-controller="Carrito"
                       asp-action="Index"
                       class="app-nav-link @Active("Carrito")">
                        <span class="app-nav-icon">🧺</span>
                        <span>Carrito</span>
                    </a>

                    <div class="app-nav-section">Próximamente</div>

                    <a href="#" class="app-nav-link disabled">
                        <span class="app-nav-icon">📊</span>
                        <span>Reportes</span>
                        <span class="app-nav-badge">Pronto</span>
                    </a>
                }
                else
                    {
                        <div class="app-nav-section">Tienda</div>

                        <a asp-controller="Tienda"
                           asp-action="Index"
                           class="app-nav-link @Active("Tienda")">
                            <span class="app-nav-icon">🛒</span>
                            <span>Ver tienda</span>
                        </a>

                        <div class="app-nav-section">Acceso</div>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="app-nav-link @Active("Account")">
                            <span class="app-nav-icon">🔐</span>
                            <span>Iniciar sesión</span>
                        </a>

                        <a asp-controller="Carrito"
                           asp-action="Index"
                           class="app-nav-link @Active("Carrito")">
                            <span class="app-nav-icon">🧺</span>
                            <span>Carrito</span>
                        </a>
                    }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div>
                    <div class="app-topbar-overline">Sistema administrativo</div>
                    <div class="app-topbar-title">@ViewData["Title"]</div>
                </div>

                <div class="app-topbar-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="text-end d-none d-md-block">
                            <div class="fw-semibold">@User.Identity.Name</div>
                            <div class="text-muted small">Sesión activa</div>
                        </div>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary rounded-pill px-4">
                                Cerrar sesión
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                            Iniciar sesión
                        </a>
                    }
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>