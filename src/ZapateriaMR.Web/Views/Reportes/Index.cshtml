@model ZapateriaMR.Web.ViewModels.Reportes.ReportesIndexViewModel
@using ZapateriaMR.Domain.Enums

@{
    ViewData["Title"] = "Reportes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Reportes</h1>
        <p class="text-muted mb-0">Consulta indicadores básicos de ventas, pedidos e inventario.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="FechaInicio" class="form-label fw-semibold">Fecha inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control rounded-pill" />
            </div>

            <div class="col-md-4">
                <label asp-for="FechaFin" class="form-label fw-semibold">Fecha fin</label>
                <input asp-for="FechaFin" type="date" class="form-control rounded-pill" />
            </div>

            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark rounded-pill">
                    Filtrar
                </button>
            </div>

            <div class="col-md-2 d-grid">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                    Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card">
            <div class="card-body">
                <div class="dashboard-card-icon bg-soft-orange">👟</div>
                <span class="text-muted small">Productos activos</span>
                <h3 class="fw-bold mb-0">@Model.Resumen.TotalProductosActivos</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card">
            <div class="card-body">
                <div class="dashboard-card-icon bg-soft-green">💰</div>
                <span class="text-muted small">Total vendido</span>
                <h3 class="fw-bold mb-0">₡@Model.Resumen.TotalVendido.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card">
            <div class="card-body">
                <div class="dashboard-card-icon bg-soft-yellow">🧾</div>
                <span class="text-muted small">Pedidos pendientes</span>
                <h3 class="fw-bold text-warning mb-0">@Model.Resumen.PedidosPendientes</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 dashboard-card">
            <div class="card-body">
                <div class="dashboard-card-icon bg-soft-red">⚠️</div>
                <span class="text-muted small">Stock bajo</span>
                <h3 class="fw-bold text-danger mb-0">@Model.Resumen.ProductosStockBajo</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-0">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1">Pedidos por estado</h5>
                    <p class="text-muted small mb-0">Distribución de pedidos según su estado actual.</p>
                </div>

                @if (!Model.Resumen.PedidosPorEstado.Any())
                {
                    <div class="text-center py-5">
                        <h6 class="fw-semibold">No hay pedidos para mostrar</h6>
                        <p class="text-muted mb-0">Ajusta el rango de fechas o registra pedidos.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Estado</th>
                                    <th>Cantidad</th>
                                    <th class="text-end pe-4">Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Resumen.PedidosPorEstado)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @if (item.Estado == EstadoPedido.Pendiente)
                                            {
                                                <span class="badge rounded-pill text-bg-warning">Pendiente</span>
                                            }
                                            else if (item.Estado == EstadoPedido.Cancelado)
                                            {
                                                <span class="badge rounded-pill text-bg-danger">Cancelado</span>
                                            }
                                            else if (item.Estado == EstadoPedido.Entregado)
                                            {
                                                <span class="badge rounded-pill text-bg-success">Entregado</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill text-bg-primary">@item.Estado</span>
                                            }
                                        </td>

                                        <td class="fw-semibold">@item.Cantidad</td>

                                        <td class="fw-bold text-end pe-4">
                                            ₡@item.Total.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-0">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1">Productos más vendidos</h5>
                    <p class="text-muted small mb-0">Ranking basado en unidades vendidas.</p>
                </div>

                @if (!Model.Resumen.ProductosMasVendidos.Any())
                {
                    <div class="text-center py-5">
                        <h6 class="fw-semibold">No hay productos vendidos</h6>
                        <p class="text-muted mb-0">Los productos aparecerán cuando existan pedidos vendidos.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th>Unidades</th>
                                    <th class="text-end pe-4">Total vendido</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Resumen.ProductosMasVendidos)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold">@item.NombreProducto</div>
                                            <span class="badge text-bg-light border">@item.CodigoSku</span>
                                        </td>

                                        <td class="fw-semibold">@item.UnidadesVendidas</td>

                                        <td class="fw-bold text-end pe-4">
                                            ₡@item.TotalVendido.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-0">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1">Productos con stock bajo</h5>
                    <p class="text-muted small mb-0">Productos que requieren reposición.</p>
                </div>

                @if (!Model.Resumen.ProductosConStockBajo.Any())
                {
                    <div class="text-center py-5">
                        <h6 class="fw-semibold">Inventario estable</h6>
                        <p class="text-muted mb-0">No hay productos con stock bajo.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Resumen.ProductosConStockBajo)
                        {
                            <a asp-controller="Inventario"
                               asp-action="Details"
                               asp-route-productoId="@item.ProductoId"
                               class="list-group-item list-group-item-action px-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl" alt="@item.NombreProducto" class="product-thumb" />
                                    }
                                    else
                                    {
                                        <div class="product-thumb-placeholder">
                                            @item.NombreProducto.Substring(0, 1).ToUpper()
                                        </div>
                                    }

                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@item.NombreProducto</div>
                                        <div class="text-muted small">
                                            SKU: @item.CodigoSku · Disponible: @item.CantidadDisponible · Mínimo: @item.StockMinimo
                                        </div>
                                    </div>

                                    <span class="badge rounded-pill text-bg-danger">Bajo</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-0">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-1">Pedidos recientes</h5>
                    <p class="text-muted small mb-0">Últimos pedidos registrados en el sistema.</p>
                </div>

                @if (!Model.Resumen.PedidosRecientes.Any())
                {
                    <div class="text-center py-5">
                        <h6 class="fw-semibold">No hay pedidos recientes</h6>
                        <p class="text-muted mb-0">Los pedidos aparecerán cuando se registren ventas.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Pedido</th>
                                    <th>Cliente</th>
                                    <th>Total</th>
                                    <th class="text-end pe-4">Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Resumen.PedidosRecientes)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge text-bg-light border">@item.NumeroPedido</span>
                                            <div class="text-muted small">
                                                @item.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </td>

                                        <td>@item.NombreCliente</td>

                                        <td class="fw-bold">₡@item.Total.ToString("N2")</td>

                                        <td class="text-end pe-4">
                                            <a asp-controller="Pedidos"
                                               asp-action="Details"
                                               asp-route-id="@item.PedidoId"
                                               class="btn-product-action action-view">
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>